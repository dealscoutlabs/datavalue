# ---------------------------------------------------------------- core
# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/datavalue?schema=public"

# Auth.js session secret.  Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin of the app. Used to build OAuth redirect URIs.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authenticated encryption key for OAuth credentials at rest (AES-256-GCM).
# MUST decode to exactly 32 bytes.  Generate with: openssl rand -base64 32
# Rotating this key makes every stored provider credential undecryptable.
ENCRYPTION_KEY=""

# Where verified-review requests are delivered. No other address is ever contacted.
LEAD_NOTIFICATION_EMAIL="leads@example.com"

# Optional SMTP for lead notification. Without it, leads are still saved and are
# visible in the admin area; the app logs a safe notice instead of emailing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DataValue <no-reply@example.com>"

# Set to "false" to hide the demo organisation entirely.
DEMO_MODE_ENABLED="true"

# ---------------------------------------------------------------- Dropbox
# https://www.dropbox.com/developers/apps  ->  Create app
#   API: "Scoped access";  Access: "Full Dropbox" (or App folder for a narrower demo)
#   Permissions tab: enable ONLY account_info.read and files.metadata.read
#   OAuth 2 Redirect URIs: http://localhost:3000/api/connect/dropbox/callback
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""

# ---------------------------------------------------------------- HubSpot
# https://app.hubspot.com/developer  ->  Create app  ->  Auth tab
#   Redirect URL: http://localhost:3000/api/connect/hubspot/callback
#   Scopes: oauth, crm.objects.contacts.read, crm.objects.companies.read,
#           crm.objects.deals.read, files
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# ---------------------------------------------------------------- Microsoft 365
# https://entra.microsoft.com  ->  App registrations  ->  New registration
#   Supported account types: "Accounts in any organizational directory"
#   Redirect URI (Web): http://localhost:3000/api/connect/microsoft/callback
#   API permissions (delegated): User.Read, Files.Read.All, Mail.Read, offline_access
#   OPTIONAL, admin consent required: Reports.Read.All  (unlocks the tenant-wide path)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" for multi-tenant, or a specific tenant GUID.
MICROSOFT_TENANT_ID="common"

# ---------------------------------------------------------------- Google (DEMO ONLY)
# See README "Google: demo-only, not launchable as designed."
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
#   Authorised redirect URI: http://localhost:3000/api/connect/google/callback
#   Enable: Google Drive API, Gmail API
#   Scopes (BOTH RESTRICTED): drive.metadata.readonly, gmail.metadata
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------- Slack
# https://api.slack.com/apps  ->  Create New App  ->  OAuth & Permissions
#   Redirect URL: http://localhost:3000/api/connect/slack/callback
#   Bot Token Scopes: files:read, channels:read, users:read
#   Do NOT add channels:history or groups:history — see README Platform Limitations.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
