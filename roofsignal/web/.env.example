# RoofSignal admin web app (server-side only; nothing here is exposed to the browser)
ROOFSIGNAL_API_URL=http://localhost:8000
# Must match ADMIN_API_TOKEN in the API's .env
ADMIN_API_TOKEN=
# Temporary admin login until Phase 2 role-based accounts. The app refuses all requests while these are unset.
ADMIN_BASIC_USER=
ADMIN_BASIC_PASSWORD=
