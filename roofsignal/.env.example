# RoofSignal environment. Copy to .env and fill in. NEVER commit real secrets.
# Every paid provider stays mocked until PAID_PROVIDERS_ENABLED=true AND it is listed in APPROVED_PROVIDERS
# AND a human has recorded a spend approval (`roofsignal spend approve`), which can only extend $5 past actual spend.

# --- Core ---
DATABASE_URL=postgresql+psycopg://roofsignal:roofsignal@localhost:5432/roofsignal
REDIS_URL=redis://localhost:6379/0
CONFIG_DIR=./config
DATA_CACHE_DIR=./.cache/data
HTTP_USER_AGENT=RoofSignal-ingest/0.1
HTTP_TIMEOUT_SECONDS=120
LANDING_BASE_URL=http://localhost:3000

# Shared secret between the Next.js admin app and the API until Phase 2 role-based auth. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# --- Paid-provider safety (defaults keep everything mocked) ---
PAID_PROVIDERS_ENABLED=false
APPROVED_PROVIDERS=[]
SPEND_STEP_USD=5.00
IMAGERY_PROVIDER=mock          # later: nearmap | eagleview (licensed providers only; never Google)
TELEPHONY_PROVIDER=mock        # later: twilio

# --- Keys for paid providers: leave blank until approved (Phase 2+) ---
# NEARMAP_API_KEY=
# EAGLEVIEW_CLIENT_ID=
# EAGLEVIEW_CLIENT_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# LINE_TYPE_LOOKUP_API_KEY=
# LITIGATOR_SCRUB_API_KEY=
# FTC_DNC_SAN=                 # Subscription Account Number from telemarketing.donotcall.gov (free for 5 area codes)
# STRIPE_SECRET_KEY=sk_test_...  # Phase 3; test mode only until approved
# STRIPE_WEBHOOK_SECRET=
# SMTP_URL=smtp://localhost:1025 # Mailpit in dev
